---
import Base from '../layouts/Base.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ProductCard from '../components/ProductCard.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import {
  BRAND_NAME,
  LEGAL_NAME,
  SITE_URL,
  PHONE,
  PHONE_TEL,
  EMAIL,
  ADDRESS,
  HOURS_SCHEMA,
  PRODUCTS,
} from '../config';

const faq = [
  {
    q: 'Does it cost anything to get a quote?',
    a: 'No. Quotes and consultations are free, and there is no obligation to buy. You will not be charged for anything unless you decide to apply for a policy.',
  },
  {
    q: 'Are you an independent agency?',
    a: 'Yes. AmeriClear Insurance Agency is independent and works with multiple insurance carriers rather than representing a single company. That lets us compare options on your behalf.',
  },
  {
    q: 'How does the process work?',
    a: 'You tell us about your situation and goals. We gather options from the carriers we work with, explain the trade-offs in plain English, and help you apply for the one you choose. We then stay available for service questions after the policy is issued.',
  },
  {
    q: 'Will I be pressured to buy?',
    a: 'No. Our job is to explain options and answer questions. If nothing fits, we will tell you, and you are free to take as much time as you need.',
  },
  {
    q: 'Will you text me?',
    a: 'Only if you ask us to. The quote form has two optional, unchecked boxes: one for service texts such as appointment reminders and one for marketing texts. You can reply STOP at any time to stop, and HELP for assistance. Texting is never a condition of getting a quote or buying a policy.',
  },
  {
    q: 'Where are you licensed?',
    a: 'We are licensed in California and can discuss additional states on request. Product availability varies by state and is subject to each carrier and underwriting approval.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'InsuranceAgency',
    name: BRAND_NAME,
    legalName: LEGAL_NAME,
    url: SITE_URL,
    ...(PHONE ? { telephone: PHONE_TEL.replace('tel:', '') } : {}),
    email: EMAIL,
    address: {
      '@type': 'PostalAddress',
      streetAddress: ADDRESS.street,
      addressLocality: ADDRESS.city,
      addressRegion: ADDRESS.state,
      postalCode: ADDRESS.zip,
      addressCountry: 'US',
    },
    openingHours: HOURS_SCHEMA,
    areaServed: { '@type': 'State', name: 'California' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

const steps = [
  { n: '01', title: 'Tell us about you', text: 'Share a few details about your situation and what you want coverage to do.' },
  { n: '02', title: 'We compare options', text: 'We gather choices from the carriers we work with and explain the trade-offs.' },
  { n: '03', title: 'You choose, we handle the paperwork', text: 'Pick the option that fits. We guide the application and stay on for service.' },
];
---

<Base
  title={BRAND_NAME}
  description="AmeriClear Insurance Agency is an independent, licensed insurance agency in Costa Mesa, California helping families compare life insurance, final expense, Medicare, and annuity options with clear, no-pressure guidance."
  jsonLd={jsonLd}
>
  <section class="hero-texture text-ivory">
    <div class="container-x grid items-center gap-10 py-16 sm:py-24 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="eyebrow !text-gold-light">Independent insurance agency · Costa Mesa, California</p>
        <h1 class="mt-3 text-4xl !text-ivory sm:text-6xl">Coverage decisions, explained clearly.</h1>
        <span class="gold-rule mt-6"></span>
        <p class="mt-6 max-w-xl text-lg text-ivory/85">
          We help you compare life insurance, final expense, Medicare, and annuity options from multiple carriers, then handle the paperwork once you choose.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/quote/" class="btn btn-gold">Get a Quote</a>
          {PHONE ? (
            <a href={PHONE_TEL} class="btn btn-outline-light"><Icon name="phone" class="mr-2 h-5 w-5" />Call {PHONE}</a>
          ) : (
            <a href="/contact/" class="btn btn-outline-light">Contact Us</a>
          )}
        </div>
      </div>
      <div class="lg:col-span-5">
        <!-- Image slot: home hero. See public/images/README.md -->
        <div class="relative aspect-[4/5] max-h-[440px] w-full rounded-sm border border-gold/40 bg-navy/60 p-6" aria-hidden="true">
          <div class="absolute inset-4 border border-gold/25"></div>
          <div class="flex h-full flex-col justify-end">
            <p class="font-serif text-2xl text-ivory/90">A Legacy of<br />Clear Guidance</p>
            <p class="mt-2 text-sm text-ivory/60">Licensed · Independent · Local</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <TrustStrip />

  <section aria-labelledby="coverage-heading" class="bg-ivory">
    <div class="container-x py-16">
      <p class="eyebrow">Our coverage</p>
      <h2 id="coverage-heading" class="mt-2 text-2xl sm:text-3xl">Products we help with</h2>
      <span class="gold-rule mt-4"></span>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {PRODUCTS.map((p) => <ProductCard {...p} />)}
      </div>
    </div>
  </section>

  <section aria-labelledby="how-heading" class="border-y border-parchment bg-white">
    <div class="container-x py-16">
      <p class="eyebrow">How it works</p>
      <h2 id="how-heading" class="mt-2 text-2xl sm:text-3xl">Three steps, no surprises</h2>
      <span class="gold-rule mt-4"></span>
      <ol class="mt-8 grid gap-8 md:grid-cols-3">
        {steps.map((s) => (
          <li class="border-t-2 border-gold pt-4">
            <p class="font-serif text-3xl text-gold">{s.n}</p>
            <h3 class="mt-2 text-xl">{s.title}</h3>
            <p class="mt-2 text-slate">{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Faq items={faq} />

  {/* The quote form intentionally lives on /quote/ and /contact/ only. Pages that load the
      chat widget must not also collect phone numbers (GoHighLevel compliance review). */}
  <section aria-labelledby="quote-heading" class="bg-ivory">
    <div class="container-x grid items-center gap-10 py-16 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="eyebrow">Start here</p>
        <h2 id="quote-heading" class="mt-2 text-2xl sm:text-3xl">Request a free, no-obligation quote</h2>
        <span class="gold-rule mt-4"></span>
        <p class="mt-4 max-w-xl text-slate">
          Share the basics on our quote page and a licensed agent will reach out during business hours. Text messaging is optional and never required.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 lg:col-span-5 lg:justify-end">
        <a href="/quote/" class="btn btn-navy">Get a Quote</a>
        <a href="/contact/" class="btn btn-outline">Contact Us</a>
      </div>
    </div>
  </section>
</Base>

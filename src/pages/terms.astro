---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SmsTerms from '../components/SmsTerms.astro';
import { LEGAL_NAME, DOMAIN, ADDRESS_LINE, PHONE_DISPLAY, EMAIL, POLICY_EFFECTIVE_DATE } from '../config';
---

<Base title="Terms & Conditions" description={`Terms and conditions for using the ${LEGAL_NAME} website, including our SMS / text messaging terms.`}>
  <PageHero eyebrow="Legal" title="Terms & Conditions" lede={`Effective date: ${POLICY_EFFECTIVE_DATE}`} />

  <article class="container-x prose-legal max-w-3xl py-14">
    <p>
      These Terms &amp; Conditions ("Terms") govern your use of https://{DOMAIN}/ (the "Site"), operated by {LEGAL_NAME} ("we", "us", or "our"). By using the Site, you agree to these Terms. If you do not agree, please do not use the Site.
    </p>

    <h2>Informational purposes</h2>
    <p>
      Content on the Site is provided for general informational purposes about insurance products and does not constitute an offer of coverage, a binding quote, or tax, legal, or financial advice. Insurance products are offered through licensed insurance carriers. Availability varies by state, and all coverage is subject to the carrier's underwriting approval and the terms of the issued policy. Only the policy contract controls.
    </p>

    <h2>Use of the Site</h2>
    <p>
      You agree to use the Site only for lawful purposes and to provide accurate information when submitting a request. You may not attempt to interfere with the Site's operation, access it through automated means, or use it to send unsolicited communications.
    </p>

    <h2>Intellectual property</h2>
    <p>
      The Site, including its text, design, and logo, is owned by {LEGAL_NAME} and protected by applicable intellectual property laws. You may view and print pages for personal, non-commercial use only.
    </p>

    <h2>Third-party links</h2>
    <p>
      The Site may link to government or carrier websites for your convenience. We are not responsible for the content or privacy practices of those sites.
    </p>

    <h2>Disclaimer of warranties and limitation of liability</h2>
    <p>
      The Site is provided "as is" without warranties of any kind. To the fullest extent permitted by law, {LEGAL_NAME} is not liable for any indirect, incidental, or consequential damages arising from your use of the Site.
    </p>

    <h2>Governing law</h2>
    <p>These Terms are governed by the laws of the State of California, without regard to conflict-of-law principles.</p>

    <SmsTerms headingLevel="h2" />

    <h2>Changes to these Terms</h2>
    <p>We may revise these Terms at any time by posting an updated version with a new effective date. Continued use of the Site after changes means you accept the revised Terms.</p>

    <h2>Contact</h2>
    <p>
      {LEGAL_NAME}<br />
      {ADDRESS_LINE}<br />
      Phone: {PHONE_DISPLAY}<br />
      Email: <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
    </p>
  </article>
</Base>

---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<section class="hero-texture text-ivory">
  <div class="container-x py-14 sm:py-20">
    {eyebrow && <p class="eyebrow !text-gold-light">{eyebrow}</p>}
    <h1 class="mt-2 max-w-3xl text-3xl !text-ivory sm:text-5xl">{title}</h1>
    <span class="gold-rule mt-5"></span>
    {lede && <p class="mt-5 max-w-2xl text-lg text-ivory/85">{lede}</p>}
  </div>
</section>

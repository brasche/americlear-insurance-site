---
/** Inline line icons drawn in-house. No icon CDN. */
interface Props {
  name: 'shield' | 'family' | 'document' | 'handshake' | 'phone' | 'mail' | 'pin' | 'clock' | 'compass' | 'check';
  class?: string;
}
const { name, class: cls = 'h-7 w-7' } = Astro.props;
const common = {
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': '1.6',
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
  viewBox: '0 0 24 24',
  'aria-hidden': 'true',
} as const;
---

{name === 'shield' && (
  <svg class={cls} {...common}><path d="M12 3 20 6v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-3Z" /><path d="m9 12 2 2 4-4" /></svg>
)}
{name === 'family' && (
  <svg class={cls} {...common}><circle cx="8" cy="7" r="3" /><circle cx="16" cy="8" r="2.5" /><path d="M2.5 20v-2a5.5 5.5 0 0 1 11 0v2" /><path d="M14 20v-1.5a4 4 0 0 1 7.5-2" /></svg>
)}
{name === 'document' && (
  <svg class={cls} {...common}><path d="M7 3h7l5 5v13H7z" /><path d="M14 3v5h5" /><path d="M9.5 13h6M9.5 17h6" /></svg>
)}
{name === 'handshake' && (
  <svg class={cls} {...common}><path d="M2 9l4-4 5 1 3-1 4 4" /><path d="M2 9v6l6 5c1 1 2.5 1 3.5 0l6-5.5" /><path d="M11 6l-3 3c-.7.7-.3 1.8.7 2l2.3-.5 4 3.5" /><path d="M22 9v6l-4 3" /></svg>
)}
{name === 'phone' && (
  <svg class={cls} {...common}><path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2Z" /></svg>
)}
{name === 'mail' && (
  <svg class={cls} {...common}><rect x="3" y="5" width="18" height="14" rx="1.5" /><path d="m3 7 9 6 9-6" /></svg>
)}
{name === 'pin' && (
  <svg class={cls} {...common}><path d="M12 21s7-6.5 7-11.5a7 7 0 0 0-14 0C5 14.5 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
)}
{name === 'clock' && (
  <svg class={cls} {...common}><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
)}
{name === 'compass' && (
  <svg class={cls} {...common}><circle cx="12" cy="12" r="9" /><path d="m15.5 8.5-2 5-5 2 2-5z" /></svg>
)}
{name === 'check' && (
  <svg class={cls} {...common}><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
)}

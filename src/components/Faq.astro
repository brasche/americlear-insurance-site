---
interface Props {
  items: { q: string; a: string }[];
  heading?: string;
}
const { items, heading = 'Frequently asked questions' } = Astro.props;
---

<section aria-labelledby="faq-heading" class="bg-parchment">
  <div class="container-x py-16">
    <p class="eyebrow">Good to know</p>
    <h2 id="faq-heading" class="mt-2 text-2xl sm:text-3xl">{heading}</h2>
    <span class="gold-rule mt-4"></span>
    <div class="mt-8 divide-y divide-gold/30 border-y border-gold/30">
      {items.map((it) => (
        <details class="group py-4">
          <summary class="flex min-h-11 items-center justify-between gap-4 font-serif text-lg text-navy">
            <span>{it.q}</span>
            <span class="faq-icon shrink-0 text-gold transition-transform" aria-hidden="true">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
            </span>
          </summary>
          <p class="mt-3 max-w-3xl text-ink">{it.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

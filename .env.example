# Where quote-form submissions are POSTed (JSON). N8N or GoHighLevel inbound webhook URL.
# Locally: copy this file to .env. In production: set the Railway service variable.
PUBLIC_FORM_ENDPOINT=

# GoHighLevel chat widget ID (data-widget-id from Sites → Chat Widget → Get Code).
# Loads on every page except /quote/ and /contact/ (pages with a phone-collecting form).
PUBLIC_LC_WIDGET_ID=
